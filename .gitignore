# Neon Tide — Palmera Bay (.gitignore)
#
# Build outputs and local tooling. The game itself is plain static files
# under game/ and needs no build step, so almost everything here is just
# keeping local clutter out of the repository.

# make.fun output directory (main.ts writes the entry here locally)
/out/
out/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# OS clutter
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo
*~
*.orig
*.rej

# Playwright / browser test artefacts
test-results/
playwright-report/
playwright/.cache/

# Local screenshots staging (the real ones live in screenshots/)
shots-tmp/
*.screenshot.png

# Environment and secrets — never commit these
.env
.env.*
*.key
*.pem
*.log
